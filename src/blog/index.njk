---
title: "Blog & Recursos — TechoSolutions"
description: "Artículos técnicos, guías y checklists sobre arquitectura de software, refactorización de legacy, deuda técnica y modernización incremental."
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/tokens.css">
<script id="counterscale-script" data-site-id="techosolutions-in" src="https://counterscale.techosolutionsin.workers.dev/tracker.js" defer></script>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { overflow-x: clip; scroll-behavior: smooth; scroll-padding-top: 5rem; }
body { overflow-x: clip; font-family: var(--font-body); font-size: var(--text-base); line-height: 1.6; color: var(--color-ink); background: var(--color-paper); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
img, svg { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
::selection { background: var(--color-accent); color: var(--color-accent-ink); }
:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }

h1, h2, h3, h4, .display { font-family: var(--font-display); font-weight: 600; font-style: normal; line-height: 1.2; letter-spacing: -0.02em; overflow-wrap: anywhere; min-width: 0; }
h1 { font-size: clamp(2rem, 4vw + 0.5rem, 3.5rem); letter-spacing: -0.03em; line-height: 1.1; }
h2 { font-size: clamp(1.75rem, 3.5vw + 0.5rem, 3rem); letter-spacing: -0.025em; }
h3 { font-size: var(--text-xl); letter-spacing: -0.02em; }
.body-large { font-size: var(--text-md); line-height: 1.65; color: var(--color-ink-2); max-width: 65ch; }
.body { font-size: var(--text-base); line-height: 1.65; color: var(--color-ink-2); max-width: 65ch; }
.accent { color: var(--color-accent); }
.muted { color: var(--color-muted); }
.wordmark { font-family: var(--font-outlier); font-weight: 600; font-size: 1.125rem; letter-spacing: -0.02em; }
.container { width: 100%; max-width: 1200px; margin-inline: auto; padding-inline: clamp(var(--space-md), 4vw, var(--space-3xl)); }
section { padding-block: var(--space-4xl); }
.section__title { margin-bottom: var(--space-xl); max-width: 20ch; }

.nav { position: fixed; top: var(--space-md); left: 50%; transform: translateX(-50%); z-index: var(--z-sticky); width: fit-content; max-width: calc(100vw - var(--space-xl)); background: var(--color-nav-bg); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); border: 1px solid var(--color-rule); border-radius: var(--radius-full); padding: var(--space-xs) var(--space-sm); display: flex; align-items: center; gap: var(--space-lg); }
.nav__wordmark { font-family: var(--font-outlier); font-weight: 600; font-size: 0.9375rem; letter-spacing: -0.02em; color: var(--color-ink); white-space: nowrap; padding: var(--space-2xs) var(--space-sm); }
.nav__wordmark span { color: var(--color-accent); }
.nav__links { display: flex; align-items: center; gap: var(--space-2xs); list-style: none; }
.nav__link { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 500; color: var(--color-muted); padding: var(--space-2xs) var(--space-sm); border-radius: var(--radius-full); transition: color var(--dur-micro) var(--ease-out), background var(--dur-micro) var(--ease-out); white-space: nowrap; }
.nav__link:hover { color: var(--color-ink); background: var(--color-paper-2); }
.nav__link--active { color: var(--color-ink); background: var(--color-paper-3); }
.nav__cta { background: var(--color-accent); color: var(--color-accent-ink) !important; font-weight: 600; padding: var(--space-2xs) var(--space-md) !important; }
.nav__cta:hover { background: var(--color-accent-2) !important; color: var(--color-accent-ink) !important; }
.nav__toggle { display: none; background: none; border: none; color: var(--color-ink); font-size: var(--text-xl); cursor: pointer; padding: var(--space-2xs); }

.page-header { padding-top: calc(var(--space-4xl) + 4rem); padding-bottom: var(--space-2xl); }
.page-header h1 { margin-bottom: var(--space-md); }

.filters { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-2xl); }
.filter-tag { font-family: var(--font-body); font-size: var(--text-sm); padding: var(--space-2xs) var(--space-md); border-radius: var(--radius-full); border: 1px solid var(--color-rule); background: transparent; color: var(--color-muted); cursor: pointer; transition: all var(--dur-micro) var(--ease-out); }
.filter-tag:hover { border-color: var(--color-accent); color: var(--color-ink); }
.filter-tag--active { background: var(--color-accent); color: var(--color-accent-ink); border-color: var(--color-accent); }

.blog__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
.blog-card { background: var(--color-paper); border: 1px solid var(--color-rule); border-radius: var(--radius-md); padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); transition: border-color var(--dur-short) var(--ease-out), opacity var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out); cursor: pointer; }
@media (hover: hover) and (pointer: fine) {
  .blog-card:hover { border-color: var(--color-accent); }
}
.blog-card[hidden] { display: none; }
.blog-card__date { font-size: var(--text-xs); color: var(--color-muted); font-family: var(--font-display); }
.blog-card h3 { font-size: var(--text-md); font-family: var(--font-display); line-height: 1.3; }
.blog-card h3 a:hover { color: var(--color-accent); }
.blog-card p { font-size: var(--text-sm); color: var(--color-muted); line-height: 1.55; }
.blog-card__link { font-size: var(--text-sm); color: var(--color-accent); font-family: var(--font-display); margin-top: auto; display: inline-flex; align-items: center; gap: var(--space-2xs); }
.blog-card__cat { font-size: var(--text-xs); color: var(--color-accent); font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.08em; }

.resources { background: var(--color-paper-2); }
.resources__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-lg); }
.resource-card { background: var(--color-paper); border: 1px solid var(--color-rule); border-radius: var(--radius-md); padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); }
.resource-card h3 { font-size: var(--text-md); font-family: var(--font-display); }
.resource-card p { font-size: var(--text-sm); color: var(--color-muted); line-height: 1.55; }
.resource-card__type { font-size: var(--text-xs); color: var(--color-accent); font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.08em; }
.resource-card__link { font-size: var(--text-sm); color: var(--color-accent); font-family: var(--font-display); display: inline-flex; align-items: center; gap: var(--space-2xs); }

.footer { border-top: 1px solid var(--color-rule); padding-block: var(--space-xl); }
.footer__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); flex-wrap: wrap; }
.footer__copy { font-size: var(--text-sm); color: var(--color-muted); }
.footer__links { display: flex; gap: var(--space-lg); list-style: none; }
.footer__links a { font-size: var(--text-sm); color: var(--color-muted); transition: color var(--dur-micro) var(--ease-out); }
.footer__links a:hover { color: var(--color-ink); }

.reveal { opacity: 0; transform: translateY(12px); transition: opacity var(--dur-long) var(--ease-out), transform var(--dur-long) var(--ease-out); }
.reveal.is-visible { opacity: 1; transform: translateY(0); }

@media (max-width: 60rem) {
  .blog__grid { grid-template-columns: 1fr; }
  .resources__grid { grid-template-columns: 1fr; }
  .nav__links { display: none; }
  .nav__toggle { display: block; }
  .nav.is-open .nav__links { display: flex; flex-direction: column; position: absolute; top: calc(100% + var(--space-xs)); left: 50%; transform: translateX(-50%); background: var(--color-paper-2); border: 1px solid var(--color-rule); border-radius: var(--radius-md); padding: var(--space-sm); min-width: 200px; gap: var(--space-2xs); }
}
@media (max-width: 40rem) {
  section { padding-block: var(--space-3xl); }
  h1 { font-size: var(--text-2xl); }
  .nav { padding: var(--space-2xs) var(--space-sm); }
  .footer__inner { flex-direction: column; text-align: center; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 150ms !important; }
  html { scroll-behavior: auto; }
  .reveal { opacity: 1; transform: none; transition: none; }
  .reveal.is-visible { opacity: 1; transform: none; }
}
</style>
</head>
<body>

<nav class="nav" role="navigation" aria-label="Navegación principal">
  <a href="/" class="nav__wordmark">tech<span>o</span>solutions</a>
  <button class="nav__toggle" aria-label="Menú" aria-expanded="false">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
  </button>
  <ul class="nav__links">
    <li><a href="/" class="nav__link">Inicio</a></li>
    <li><a href="/servicios/" class="nav__link">Servicios</a></li>
    <li><a href="/blog/" class="nav__link nav__link--active">Blog & Recursos</a></li>
    <li><a href="/casos/" class="nav__link">Casos</a></li>
    <li><a href="/sobre-mi/" class="nav__link">Sobre mí</a></li>
    <li><a href="/contacto/" class="nav__link nav__cta">Contacto</a></li>
  </ul>
</nav>

<section class="page-header">
  <div class="container">
    <p class="hero__eyebrow" style="font-family: var(--font-display); font-size: var(--text-sm); color: var(--color-accent); margin-bottom: var(--space-md); letter-spacing: 0.08em; text-transform: uppercase;">· blog &amp; recursos</p>
    <h1>Contenido técnico para equipos que quieren salir del pozo</h1>
    <p class="body-large">Artículos, guías y checklists sobre arquitectura, refactorización de legacy, deuda técnica y modernización incremental.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="filters">
      <button class="filter-tag filter-tag--active" data-filter="all">Todos</button>
      <button class="filter-tag" data-filter="legacy">Legacy &amp; deuda técnica</button>
      <button class="filter-tag" data-filter="cloud">Cloud &amp; performance</button>
      <button class="filter-tag" data-filter="refactor">Refactor vs rewrite</button>
      <button class="filter-tag" data-filter="diy">IA / no-code / sistemas DIY</button>
    </div>

    <h2 class="section__title reveal">Artículos</h2>
    <div class="blog__grid" id="posts-grid">
      {% for post in collections.posts %}
      <article class="blog-card reveal" data-category="{{ post.data.category | slug }}" style="--i: {{ loop.index0 }}">
        <span class="blog-card__cat">{{ post.data.category }}</span>
        <time class="blog-card__date" datetime="{{ post.date.toISOString().slice(0, 10) }}">{{ post.date | monthYear }}</time>
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p>{{ post.data.excerpt }}</p>
        <a href="{{ post.url }}" class="blog-card__link">Leer más →</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="resources">
  <div class="container">
    <h2 class="section__title reveal">Recursos descargables</h2>
    <div class="resources__grid">
      <div class="resource-card reveal" style="--i: 0">
        <span class="resource-card__type">PDF · Checklist</span>
        <h3>Checklist de arquitectura para sistemas DIY</h3>
        <p>Fundaste tu empresa, codeaste el MVP, lo armaste con IA o lo heredaste de un freelance. Esta checklist te ayuda a diagnosticar tu sistema en 20 minutos.</p>
        <span class="resource-card__link">Descargar →</span>
      </div>
      <div class="resource-card reveal" style="--i: 1">
        <span class="resource-card__type">PDF · Plantilla</span>
        <h3>Plantilla de informe de riesgos técnicos</h3>
        <p>Traducí problemas técnicos a impacto de negocio. Una plantilla para comunicar deuda técnica al board o al cliente sin sonar a "todo está mal".</p>
        <span class="resource-card__link">Descargar →</span>
      </div>
      <div class="resource-card reveal" style="--i: 2">
        <span class="resource-card__type">PDF · Guía</span>
        <h3>Guía: cómo decidir qué parte de tu sistema tocar primero</h3>
        <p>No todo es prioridad. Un framework simple para identificar qué módulo refactorizar primero según impacto de negocio, riesgo técnico y esfuerzo.</p>
        <span class="resource-card__link">Descargar →</span>
      </div>
      <div class="resource-card reveal" style="--i: 3">
        <span class="resource-card__type">PDF · Checklist</span>
        <h3>Checklist de costos cloud para equipos pequeños</h3>
        <p>10 puntos para revisar si estás pagando de más en tu cloud bill. De servicios huérfanos a instancias mal dimensionadas.</p>
        <span class="resource-card__link">Descargar →</span>
      </div>
    </div>
  </div>
</section>

<footer class="footer" role="contentinfo">
  <div class="container footer__inner">
    <p class="footer__copy">© 2026 TechoSolutions — Arquitectura de software que paga dividendos</p>
    <ul class="footer__links">
      <li><a href="/sobre-mi/">Sobre mí</a></li>
      <li><a href="/servicios/">Servicios</a></li>
      <li><a href="/blog/">Blog & Recursos</a></li>
      <li><a href="/casos/">Casos</a></li>
      <li><a href="/contacto/">Contacto</a></li>
    </ul>
  </div>
</footer>

<script>
document.querySelector('.nav__toggle')?.addEventListener('click', function() {
  const nav = this.closest('.nav');
  const expanded = nav.classList.toggle('is-open');
  this.setAttribute('aria-expanded', expanded);
});
document.querySelectorAll('.nav__link').forEach(link => {
  link.addEventListener('click', () => {
    document.querySelector('.nav')?.classList.remove('is-open');
  });
});
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('is-visible');
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

const filterButtons = document.querySelectorAll('.filter-tag');
const postCards = document.querySelectorAll('.blog-card[data-category]');
filterButtons.forEach(btn => {
  btn.addEventListener('click', () => {
    filterButtons.forEach(b => b.classList.remove('filter-tag--active'));
    btn.classList.add('filter-tag--active');
    const filter = btn.dataset.filter;
    postCards.forEach(card => {
      if (filter === 'all' || card.dataset.category === filter) {
        card.hidden = false;
      } else {
        card.hidden = true;
      }
    });
  });
});
</script>
</body>
</html>
